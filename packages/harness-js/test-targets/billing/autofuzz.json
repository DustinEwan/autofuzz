{
  "project": "billing-test-target",
  "codebase": {
    "harness": "js-ts",
    "command": ["node", "packages/harness-js/dist/server.js"],
    "include": ["src/**/*.ts"],
    "exclude": ["**/node_modules/**", "**/dist/**", "**/*.d.ts"]
  },
  "oracles": {},
  "budget": {
    "invocations": 50000,
    "wallClockMs": 3600000,
    "workers": 0,
    "maxCorpus": 2048,
    "strategy": "guided"
  },
  "output": {
    "dir": ".autofuzz",
    "renderers": ["json", "markdown"]
  }
}
