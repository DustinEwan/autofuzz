{
  "name": "@autofuzz/harness-js",
  "version": "0.1.0",
  "private": true,
  "description": "autofuzz harness plugin for TypeScript and JavaScript targets",
  "type": "module",
  "bin": {
    "afz-harness-js": "./dist/server.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs test/*.test.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  }
}
