{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request",
  "description": "A request. `id` is assigned by the engine and echoed on the matching response.",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "jsonrpc": {
      "$ref": "#/$defs/JsonRpcVersion"
    },
    "method": {
      "type": "string"
    },
    "params": true
  },
  "required": [
    "jsonrpc",
    "id",
    "method"
  ],
  "$defs": {
    "JsonRpcVersion": {
      "description": "The only protocol revision this build speaks.",
      "type": "string",
      "enum": [
        "2.0"
      ]
    }
  }
}
